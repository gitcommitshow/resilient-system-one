{
  "name": "resilient-system-one",
  "version": "0.1.0",
  "description": "TypeScript client for the System One decision API.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "mocha --node-option experimental-strip-types --node-option no-warnings",
    "test:e2e": "mocha --node-option experimental-strip-types --node-option no-warnings 'test/**/*.e2e.test.ts'"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/chai": "^5.2.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.3.0",
    "@types/sinon": "^17.0.4",
    "chai": "^5.2.1",
    "mocha": "^12.0.3",
    "sinon": "^22.1.0",
    "typescript": "^5.9.2"
  }
}
